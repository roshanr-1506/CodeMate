NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
# Leave empty ONLY in development for embedded PostgreSQL in .data/postgres.
DATABASE_URL=
DATABASE_SSL=false
SESSION_SECRET=
SESSION_TTL_HOURS=12
SESSION_IDLE_SECONDS=120
# Optional native UCI executable; blank uses the bundled Stockfish WASM engine.
STOCKFISH_PATH=
ENGINE_WORKERS=2
ENGINE_QUEUE_SIZE=1000
DEMO_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional Supabase metadata; only DATABASE_URL is needed for PostgreSQL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SOCKET_SERVER_URL=
COOKIE_SAME_SITE=lax
# Optional separate frontend deployment; same-site custom domains recommended.
VITE_BACKEND_URL=
